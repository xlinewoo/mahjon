<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3D 麻将前端原型 · Three.js</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #1d5c3f;
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
  #app { position: fixed; inset: 0; }
  .hud { position: fixed; color: #f5efdd; text-shadow: 0 1px 2px rgba(0,0,0,.5);
    pointer-events: none; user-select: none; }
  #hud-tl { top: 14px; left: 16px; font-size: 14px; line-height: 1.7; }
  #hud-tr { top: 14px; right: 16px; font-size: 14px; line-height: 1.7; text-align: right; }
  #hud-bar { bottom: 16px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 10px; pointer-events: auto; }
  #hud-bar button { pointer-events: auto; border: 1px solid rgba(245,239,221,.5);
    background: rgba(0,0,0,.35); color: #f5efdd; padding: 8px 18px; font-size: 14px;
    border-radius: 6px; cursor: pointer; backdrop-filter: blur(4px); }
  #hud-bar button:hover { background: rgba(0,0,0,.55); border-color: #f5efdd; }
  #hud-msg { bottom: 64px; left: 50%; transform: translateX(-50%); font-size: 15px;
    color: #ffe9a8; }
  .tag { display: inline-block; padding: 0 6px; border-radius: 4px;
    background: rgba(0,0,0,.35); font-size: 12px; margin-right: 4px; }
</style>
</head>
<body>
<div id="app"></div>
<div class="hud" id="hud-tl"></div>
<div class="hud" id="hud-tr"></div>
<div class="hud" id="hud-msg"></div>
<div class="hud" id="hud-bar">
  <button id="btn-draw">摸牌</button>
  <button id="btn-opp">对家出牌</button>
  <button id="btn-meld">模拟副露</button>
  <button id="btn-restart">重开</button>
</div>

<script>
