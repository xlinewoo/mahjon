# 武汉麻将 网络对战服务 —— 环境变量模板
# 用法：cp .env.example .env  然后按需修改（.env 已被 .gitignore / .dockerignore 排除）
#
# ⚠️ 2026-10-29：本模板此前混用两套变量名，照着配会**静默失效**：
#     · 应用真正读的是  PORT / DATA_DIR  （server/index.js、server/db.js）
#     · docker compose 读的是 MAHJON_PORT / DATA_PATH（宿主侧端口映射与卷挂载，
#       由 compose 自己注入给容器的 PORT / DATA_DIR）
#   下面分两组写清楚，别再把 compose 变量当应用变量用。

# ── 必填 ────────────────────────────────────────────────
# JWT 签名密钥：令牌的「印章」，不配则每次启动随机生成、重启即全员掉线。
# 生成方式：openssl rand -hex 32
# 配好后**不要再改**（改了等于把所有已签发令牌作废）；多实例部署必须共用同一把。
JWT_SECRET=change-me-用-openssl-rand-hex-32-生成

# 登录 token 有效期（如 7d / 12h / 30d）。配合 /api/auth/logout 可随时整体作废旧令牌。
TOKEN_TTL=7d

# ── 应用变量（node server/index.js 直接读）─────────────────
# 监听端口与地址。HOST=0.0.0.0 才能被局域网/手机访问；只想本机调试可设 127.0.0.1
PORT=3000
HOST=0.0.0.0

# 数据落盘目录（账号库 mahjon.db + 上传头像）。留空 = server/data。
# ⚠️ 这个目录里有 900+ 条密码哈希与全部牌局回放，服务会自动收紧为 700/600，
#    但别把它放在任何「别人可读」的位置（例如共享盘）。
DATA_DIR=

# 允许的跨域来源。留空 = 回显请求来源（局域网 / 直连够用）。
# 走域名 + 反向代理且前端与后端同源时可留空；前后端不同源时填，多个用逗号分隔：
# CORS_ORIGIN=https://mahjong.example.com,http://192.168.8.100:3000
CORS_ORIGIN=

# 是否允许用户把头像设为第三方 URL（默认关闭，偏自托管 / 合规取向）
ALLOW_THIRD_PARTY_AVATAR=false

# ── Docker / compose 专用（宿主侧，与上面的应用变量不是一回事）──────
# 宿主机端口（NAS 上 3000 若被占用可改，如 13000）
MAHJON_PORT=3000

# 数据卷：留空 → 具名卷 mahjon-data（Docker 管理）；绝对路径 → 绑定挂载该目录
DATA_PATH=

# npm 源，国内建议改成 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org/
